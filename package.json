{
  "name": "alphababy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:purs && npm run build:backend && vite build --base ./",
    "build:purs": "spago build",
    "build:backend": "purs-backend-es bundle-app --main Main --platform browser --to app.js --source-maps",
    "dev": "npm run build:purs && npm run build:backend && vite",
    "preview": "vite preview",
    "format": "purs-tidy format-in-place 'src/**/*.purs' 'test/**/*.purs'",
    "format:check": "purs-tidy check 'src/**/*.purs' 'test/**/*.purs'",
    "icons": "node scripts/generate-icons.js",
    "test": "spago test",
    "validate": "npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/andika": "5.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "purescript": "0.15.16",
    "purs-backend-es": "1.4.3",
    "purs-tidy": "0.11.1",
    "sharp": "^0.35.3",
    "spago": "1.0.4",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0"
  }
}
